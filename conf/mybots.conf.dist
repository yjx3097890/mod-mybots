[worldserver]

###################################################################################################
#  mod-mybots
#  Personal character director on top of official mod-playerbots.
#  在官方 mod-playerbots 之上，对本机在线角色做托管/导演。
###################################################################################################

# Enable the module
# 是否启用本模块
# Default / 默认: 1
MyBots.Enable = 1

# Allow wrapping Playerbots Selfbot for a real online character
# 是否允许给真实在线角色挂上 Playerbots Selfbot（由本模块封装启停）
# Default / 默认: 1
MyBots.Selfbot.Allow = 1

# If 1, in-game players can only toggle Selfbot on themselves.
# Console / SOAP / HTTP API can still target a named character.
# 为 1 时：游戏内玩家只能对自己开关 Selfbot；
# 控制台 / SOAP / HTTP API 仍可指定其他角色名。
# Default / 默认: 1
MyBots.Selfbot.SelfOnlyInGame = 1

# After enabling Selfbot, drop Playerbots autonomous quest/travel so this
# module can direct the character later.
# 开启 Selfbot 后去掉 Playerbots 自带的任务/旅行/RPG 自主策略，
# 方便本模块后续接管导演，避免双方抢控制。
# Set to 0 to enable official autonomous play: +new rpg,+grind,-follow
# 设为 0 时主动挂上官方自主游玩策略（Selfbot 默认不会像随机机器人那样自己玩）。
# Job 导演运行时应保持为 1，避免与 Job 抢控制。
# Default / 默认: 1
MyBots.Selfbot.DisableRpgQuest = 1

# Drop client-*driven* movement packets while Selfbot AI is attached (reduces
# rubber-banding). Teleport / force-speed ACKs are still accepted so the client
# does not desync into "sprint then snap back".
# Selfbot 挂载期间只丢弃客户端主动移动包；传送/强制速度 ACK 仍放行，避免加速后回弹。
# Default / 默认: 1
MyBots.Selfbot.IgnoreClientMovement = 1

###################################################################################################
#  Local JSON API for your existing management backend
#  给已有管理系统后端用的 JSON API
###################################################################################################

# Enable the HTTP JSON API
# 是否启用 HTTP JSON API
# Default / 默认: 1
MyBots.Api.Enable = 1

# Bind address
# 监听地址
# Default / 默认: "127.0.0.1"
MyBots.Api.Bind = "0.0.0.0"

# TCP port
# TCP 端口
# Default / 默认: 9100
MyBots.Api.Port = 9100

# Shared secret. Send as: Authorization: Bearer <token>
# 共享密钥，请求头带：Authorization: Bearer <token>
MyBots.Api.Token = "change-me"

# How long an HTTP call waits for the world thread (milliseconds)
# HTTP 等待世界线程处理意图的超时（毫秒）
# Default / 默认: 3000
MyBots.Api.TimeoutMs = 3000

# Max pending intents; excess returns HTTP 429
# 意图队列上限，超出返回 429
# Default / 默认: 64
MyBots.Api.QueueMax = 64

###################################################################################################
#  Jobs / Director / Executor
###################################################################################################

# New job cancels the previous active job for the same character
# 新作业是否抢占同一角色的旧作业
# Default / 默认: 1
MyBots.Job.Replace = 1

# Seconds without meaningful movement before move_to escalates (detour / fail)
# move_to 卡住判定秒数，超时后触发侧面绕行重试，重试用尽才判失败
# Default / 默认: 45
MyBots.Executor.StuckTimeoutSec = 45

# Director tick interval (milliseconds)
# 导演心跳间隔（毫秒）
# Default / 默认: 1000
MyBots.Director.TickMs = 1000

###################################################################################################
#  Navigation / 寻路
###################################################################################################

# Use flight paths for long trips instead of walking the whole way.
# OFF by default: early builds boarded via ActivateTaxiPathTo(nullptr) which
# starts a flight from mid-map (not at a flight master) and could Clear() the
# spline mid-air, looping Goldshire board→drop→board.
# 默认关闭。以前用脚本接口会在非飞行点突然上天，并在起飞瞬间清 MotionMaster
# 造成闪金镇登机死循环。需要时再开，且只会通过真正的飞行管理员上车。
# Default / 默认: 0
MyBots.Nav.UseTaxi = 0

# Minimum straight-line distance (yards) before a flight path is considered
# 触发飞行点的最小直线距离（码）
# Default / 默认: 600
MyBots.Nav.TaxiMinDistance = 600

# Distance (yards) within which the character is considered at the flight point
# 距离飞行点多近算“已到登机点”（码）
# Default / 默认: 12
MyBots.Nav.TaxiBoardDistance = 12

# When the job character boards a flight, also board nearby party selfbots
# at the same flight master onto the same path.
# 作业角色登机时，同队、已在附近飞行点的 Selfbot 小号一起飞。
# Default / 默认: 1
MyBots.Nav.TaxiPartyFollow = 1

# Seconds to wait before re-evaluating a flight path after it was unusable
# 判定“本次不适合坐飞行点”后，多少秒再重新评估
# Default / 默认: 120
MyBots.Nav.TaxiRetrySec = 120

# Minimum seconds between re-issuing the same destination to the movement
# generator. Re-pathing every tick causes stutter / speed hitch.
# 同一目的地重新下发移动指令的最小间隔（秒）。过频重算会加速抽一下再回弹。
# Default / 默认: 10
MyBots.Nav.RepathSec = 10

# How many detour attempts before move_to gives up
# 绕行重试次数，用尽后 move_to 判失败
# Default / 默认: 4
MyBots.Nav.MaxStuckRetries = 4

# Radius (yards) of the side offset point used when stuck
# 卡住时侧面偏移点的半径（码）
# Default / 默认: 10
MyBots.Nav.DetourRadius = 10

# Seconds a detour point stays the active target
# 绕行点作为临时目标的持续秒数
# Default / 默认: 12
MyBots.Nav.DetourSec = 12

# Radius (yards) within which a recorded bad point blocks a detour candidate
# 坏点生效半径（码），该范围内不再选为绕行点
# Default / 默认: 6
MyBots.Nav.BadPointRadius = 6

# Seconds a bad point is remembered
# 坏点记忆时长（秒）
# Default / 默认: 900
MyBots.Nav.BadPointTtlSec = 900

# Read Playerbots TravelMgr's bad-navmesh grids when validating detour points.
# Read-only: this module never writes into TravelMgr. Needs a mod-playerbots
# that exposes isBadMmap, otherwise the integration is compiled out.
# 校验绕行点时，只读复用 Playerbots TravelMgr 已知的“导航网格坏格”。
# 本模块不会写入 TravelMgr；若 mod-playerbots 没有该接口则编译期自动关闭。
# Default / 默认: 1
MyBots.Nav.UseTravelMgr = 1

###################################################################################################
#  LLM quest planner (DeepSeek / OpenAI-compatible Chat Completions)
#  LLM 任务规划（DeepSeek / OpenAI 兼容接口，工作线程调用，不阻塞地图线程）
###################################################################################################

# Enable async LLM planning for complete_quest when no hand-written steps/script
# 开启后：complete_quest 无手写 steps / DB 脚本时，先异步调 LLM 规划再执行
# Default / 默认: 0
MyBots.Llm.Enable = 0

# API base URL (OpenAI-compatible). Path /chat/completions is appended.
# API 基址（OpenAI 兼容）。自动追加 /chat/completions。
# Default / 默认: "https://api.deepseek.com"
MyBots.Llm.BaseUrl = "https://api.deepseek.com"

# Bearer API key (required when Enable = 1)
# Bearer API Key（Enable=1 时必填）
# Default / 默认: ""
MyBots.Llm.ApiKey = ""

# Model name
# 模型名（可改为 deepseek-flash / deepseek-v4-pro 等）
# Default / 默认: "deepseek-chat"
MyBots.Llm.Model = "deepseek-chat"

# Outbound HTTP timeout (ms)
# 出站请求超时（毫秒）
# Default / 默认: 60000
MyBots.Llm.TimeoutMs = 60000

# On LLM/validate failure, fall back to the rule-based BuildCompleteQuest planner
# LLM/校验失败时回退到规则规划器
# Default / 默认: 1
MyBots.Llm.FallbackRules = 1

# Max steps accepted from the model
# 模型返回的最大步数
# Default / 默认: 32
MyBots.Llm.MaxSteps = 32

# When move_to fails with stuck/unreachable, ask the LLM for a high-level
# alternate plan (different NPCs / wait / interact) — not tick-level pathfinding.
# 卡住/不可达时让 LLM 做高层改道（换 NPC/等待/对话），不替代每 tick 网格寻路。
# Default / 默认: 1
MyBots.Llm.ReplanOnStuck = 1

# Minimum seconds between two LLM replans on the same job
# 同一 Job 两次 LLM 重规划的最小间隔（秒）
# Default / 默认: 90
MyBots.Llm.ReplanCooldownSec = 90

# Max LLM replans per job (after initial plan)
# 每个 Job 最多 LLM 重规划次数（不含首次规划）
# Default / 默认: 2
MyBots.Llm.ReplanMax = 2
